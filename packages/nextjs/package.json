{
  "name": "@se-2/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "yarn lint && next build",
    "check-types": "tsc --noEmit --incremental",
    "dev": "next dev",
    "format": "prettier --write . '!(node_modules|.next)/**/*'",
    "lint": "yarn eslint .",
    "serve": "next start",
    "start": "next dev",
    "vercel": "npx --yes vercel@latest --build-env YARN_ENABLE_IMMUTABLE_INSTALLS=false --build-env ENABLE_EXPERIMENTAL_COREPACK=1 --build-env VERCEL_TELEMETRY_DISABLED=1",
    "vercel:login": "npx --yes vercel@latest login",
    "vercel:yolo": "npx --yes vercel@latest --build-env YARN_ENABLE_IMMUTABLE_INSTALLS=false --build-env ENABLE_EXPERIMENTAL_COREPACK=1 --build-env NEXT_PUBLIC_IGNORE_BUILD_ERROR=true --build-env VERCEL_TELEMETRY_DISABLED=1",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@heroicons/react": "~2.2.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@scaffold-ui/components": "^0.1.12",
    "@scaffold-ui/debug-contracts": "^0.1.11",
    "@scaffold-ui/hooks": "^0.1.8",
    "@tanstack/react-query": "~5.100.5",
    "blo": "~2.0.0",
    "burner-connector": "0.0.21",
    "daisyui": "5.7.47",
    "kubo-rpc-client": "~6.1.0",
    "next": "~16.3.8",
    "next-nprogress-bar": "~2.4.7",
    "next-themes": "~0.4.6",
    "qrcode.react": "~4.2.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hot-toast": "~2.6.0",
    "usehooks-ts": "~3.1.1",
    "viem": "2.53.1",
    "wagmi": "2.19.5",
    "zustand": "~5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "~6.0.2",
    "@types/jsdom": "^30",
    "@types/node": "~18.19.130",
    "@types/react": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "abitype": "1.3.0",
    "eslint": "~9.39.0",
    "eslint-config-next": "~16.3.8",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.5",
    "jsdom": "^30.1.1",
    "postcss": "~8.5.10",
    "prettier": "~3.8.3",
    "tailwindcss": "4.3.3",
    "type-fest": "~5.10.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.13.0"
}
